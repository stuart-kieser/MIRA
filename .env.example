# Application API
NODE_ENV=development
API_PORT=3001
APP_URL=http://localhost:5173
# Optional separate origin routed by Nginx, such as https://admin.example.com
# ADMIN_APP_URL=https://admin.example.com
DATABASE_URL=postgres://mira:replace-with-your-postgres-password@127.0.0.1:5432/mira

# Generate a unique value with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-this-with-at-least-32-random-characters
REQUIRE_EMAIL_VERIFICATION=false
# Your reverse proxy must overwrite this header; never pass through a client-supplied value.
AUTH_IP_HEADER=x-forwarded-for
# Comma-separated bootstrap administrators. Roles are still checked by Express.
ADMIN_EMAILS=admin@example.com

# Optional local GPU tools only; the hosted application does not connect to this worker.
RECONSTRUCTION_WORKER_URL=http://localhost:8787
RECONSTRUCTION_WORKER_TOKEN=replace-with-a-separate-random-worker-token

# Development only. This is ignored when NODE_ENV=production.
DEV_BYPASS_PAYWALL=false

# Per-scan prices in the currency's smallest unit (these examples are ZAR cents).
BILLING_CURRENCY=zar
PRICE_QUICK_CENTS=2900
PRICE_PREVIEW_CENTS=4900
PRICE_BALANCED_CENTS=7900
PRICE_HIGH_CENTS=12900
PRICE_MAXIMUM_CENTS=19900

# Persistent private storage on the application server. Back up alongside PostgreSQL.
STORAGE_DIRECTORY=storage
# Replace with your actual banking details and payment contact before accepting EFTs.
EFT_INSTRUCTIONS="Contact support for bank details before paying. Use your EFT order reference."

# Required in production for password reset and verification email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Mira <no-reply@example.com>
